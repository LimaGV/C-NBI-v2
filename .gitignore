# Ambientes, caches e builds
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
dist/
build/
*.egg-info/
.ipynb_checkpoints/
# Payloads científicos: publicar só após classificação e aprovação explícitas
/data/raw/**
!/data/raw/**/
!/data/raw/**/README.md
/data/snapshots/**
!/data/snapshots/**/
!/data/snapshots/**/README.md
/data/interim/**
!/data/interim/**/
!/data/interim/**/README.md
/data/processed/**
!/data/processed/**/
!/data/processed/**/README.md
/data/external/**
!/data/external/**/
!/data/external/**/README.md
# Documentos locais: somente notas e metadados textuais seletivos
/references/local_library/**
!/references/local_library/**/
!/references/local_library/**/*.md
!/references/local_library/**/*.bib
!/references/local_library/**/*.yaml
!/references/local_library/**/*.yml
!/references/local_library/**/*.json
!/references/local_library/**/*.csv
# Secrets prevalecem sobre exceções de publicação
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
secrets.*
.codex/
.serena/
# Dados e resultados não são incorporados automaticamente
/results/*
!/results/README.md
/experiments/runs/
references/papers/*
!references/papers/README.md
references/theses_dissertations/*
!references/theses_dissertations/README.md
references/books_notes/*
!references/books_notes/README.md
references/standards_manuals/*
!references/standards_manuals/README.md
repomix-output*
.DS_Store
Thumbs.db
.vscode/
.idea/
